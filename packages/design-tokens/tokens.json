{
  "$schema": "https://design-tokens.org/schema.json",
  "$description": "Ninotek Design System — NGUỒN SỰ THẬT DUY NHẤT. Không hard-code mã màu trong .xaml hay .dart. Chạy tools/scripts/gen-tokens.js để sinh NinotekColors.xaml (WPF) và nino_theme.dart (Flutter).",
  "$version": "1.0.0",

  "color": {
    "brand": {
      "primary":        { "value": "#007AFF", "comment": "Ninotek Blue — nút chính, tab đang chọn" },
      "primaryDark":    { "value": "#0055FF", "comment": "Điểm cuối gradient thương hiệu" },
      "primaryLight":   { "value": "#4DA3FF" },
      "primaryPressed": { "value": "#0062CC" },
      "gradient":       { "value": ["#007AFF", "#0055FF"], "type": "linearGradient", "angle": 135 }
    },
    "semantic": {
      "success": { "value": "#34C759", "comment": "Bàn trống / Món đã xong / Thanh toán thành công" },
      "warning": { "value": "#FF9500", "comment": "Đang chế biến / Sắp hết nguyên liệu" },
      "danger":  { "value": "#FF3B30", "comment": "Cảnh báo kho / Bàn chờ trả tiền / Huỷ món" },
      "info":    { "value": "#5AC8FA" }
    },
    "surface": {
      "background": { "value": "#F2F2F7", "comment": "Nền ứng dụng" },
      "card":       { "value": "#FFFFFF" },
      "elevated":   { "value": "#FFFFFF" },
      "divider":    { "value": "#E5E5EA" },
      "overlay":    { "value": "#00000066" }
    },
    "text": {
      "primary":    { "value": "#1C1C1E" },
      "secondary":  { "value": "#6E6E73" },
      "tertiary":   { "value": "#AEAEB2" },
      "onPrimary":  { "value": "#FFFFFF" },
      "disabled":   { "value": "#C7C7CC" }
    },
    "tableStatus": {
      "EMPTY":    { "value": "#34C759", "label": "Trống" },
      "OCCUPIED": { "value": "#007AFF", "label": "Có khách" },
      "RESERVED": { "value": "#FF9500", "label": "Đã đặt" },
      "BILLING":  { "value": "#FF3B30", "label": "Chờ thanh toán" },
      "LOCKED":   { "value": "#AEAEB2", "label": "Đang bị khoá" }
    },
    "kitchenStatus": {
      "WAITING":   { "value": "#AEAEB2", "label": "Chờ làm" },
      "COOKING":   { "value": "#FF9500", "label": "Đang chế biến" },
      "READY":     { "value": "#34C759", "label": "Đã xong" },
      "SERVED":    { "value": "#007AFF", "label": "Đã lên bàn" },
      "CANCELLED": { "value": "#FF3B30", "label": "Đã huỷ" }
    },
    "chart": {
      "$comment": "Bảng màu biểu đồ NinoDash — kiểm định tương phản AA trên nền sáng và tối",
      "series": {
        "value": ["#007AFF", "#34C759", "#FF9500", "#AF52DE", "#FF3B30", "#5AC8FA"]
      }
    }
  },

  "typography": {
    "fontFamily": {
      "primary":  { "value": "Inter", "fallback": ["Segoe UI", "Roboto", "system-ui", "sans-serif"] },
      "numeric":  { "value": "Inter", "comment": "Dùng tabular-nums cho cột tiền để số thẳng hàng" },
      "receipt":  { "value": "Consolas", "fallback": ["Courier New", "monospace"], "comment": "Xem trước bill nhiệt" }
    },
    "scale": {
      "displayLarge": { "size": 48, "weight": 700, "lineHeight": 1.15, "comment": "Card doanh thu real-time NinoDash" },
      "display":      { "size": 34, "weight": 700, "lineHeight": 1.2 },
      "h1":           { "size": 28, "weight": 600, "lineHeight": 1.25 },
      "h2":           { "size": 22, "weight": 600, "lineHeight": 1.3 },
      "h3":           { "size": 18, "weight": 600, "lineHeight": 1.35 },
      "body":         { "size": 16, "weight": 400, "lineHeight": 1.5, "comment": "Tối thiểu cho màn POS — không dùng nhỏ hơn cho nội dung chính" },
      "bodyStrong":   { "size": 16, "weight": 600, "lineHeight": 1.5 },
      "caption":      { "size": 13, "weight": 400, "lineHeight": 1.4 },
      "button":       { "size": 16, "weight": 600, "lineHeight": 1.2 }
    }
  },

  "spacing": {
    "$comment": "Thang 4pt. Dùng token, không dùng số lẻ.",
    "xs": { "value": 4 }, "sm": { "value": 8 },  "md": { "value": 12 },
    "lg": { "value": 16 }, "xl": { "value": 24 }, "xxl": { "value": 32 }, "xxxl": { "value": 48 }
  },

  "radius": {
    "sm":   { "value": 6 },
    "md":   { "value": 10 },
    "lg":   { "value": 16, "comment": "Thẻ bàn, thẻ món" },
    "pill": { "value": 999 }
  },

  "elevation": {
    "card":  { "y": 2, "blur": 8,  "color": "#0000001A" },
    "modal": { "y": 8, "blur": 24, "color": "#00000029" }
  },

  "touchTarget": {
    "$comment": "Ràng buộc BẮT BUỘC theo mục 5 Master SRS — mọi phần tử bấm được phải đạt tối thiểu 48x48dp.",
    "minimum":     { "value": 48, "unit": "dp" },
    "comfortable": { "value": 56, "unit": "dp", "comment": "Nút món trên lưới menu POS" },
    "large":       { "value": 72, "unit": "dp", "comment": "Nút Thanh toán / Gửi Bếp / Bàn phím số" },
    "spacingBetween": { "value": 8, "unit": "dp", "comment": "Khoảng hở tối thiểu giữa 2 nút để tránh bấm nhầm" }
  },

  "layout": {
    "ninoPos": {
      "$comment": "Bố cục 3 cột cho màn cảm ứng 15-19 inch (1366x768 / 1920x1080)",
      "leftColumn":   { "value": "20%", "comment": "Danh mục món + tab chuyển màn" },
      "centerColumn": { "value": "55%", "comment": "Sơ đồ bàn hoặc lưới món" },
      "rightColumn":  { "value": "25%", "comment": "Hoá đơn hiện tại + nút thanh toán" },
      "minWindowWidth": { "value": 1366 }
    },
    "ninoOrder": {
      "menuGridColumns": { "tablet": 4, "phone": 2 },
      "bottomBarHeight": { "value": 72 }
    }
  },

  "motion": {
    "fast":   { "value": 150, "unit": "ms", "comment": "Phản hồi chạm nút" },
    "normal": { "value": 250, "unit": "ms" },
    "slow":   { "value": 400, "unit": "ms" },
    "easing": { "value": "cubic-bezier(0.4, 0.0, 0.2, 1)" }
  },

  "connectivity": {
    "$comment": "Hằng số cho kịch bản Offline-First — mục 4 Master SRS",
    "lanReconnectIntervalMs": { "value": 3000, "comment": "NinoOrder tự thử kết nối lại mỗi 3 giây" },
    "lanTimeoutMs":           { "value": 500,  "comment": "Ngưỡng độ trễ tối đa LAN NinoOrder -> NinoPOS" },
    "cloudSyncIntervalMs":    { "value": 30000 },
    "cloudSyncBatchSize":     { "value": 100 },
    "tableLockTtlSeconds":    { "value": 30, "comment": "Soft-lock bàn tự nhả sau 30 giây" },
    "qrSessionTtlMinutes":    { "value": 15 }
  },

  "printing": {
    "paperWidth80mm": { "chars": 48, "dots": 576 },
    "paperWidth58mm": { "chars": 32, "dots": 384 },
    "cashDrawerCommand": { "value": "1B 70 00 19 FA", "comment": "ESC p 0 25 250 — xung mở két RJ11 qua máy in bill" },
    "cutCommand":        { "value": "1D 56 42 00",    "comment": "GS V B 0 — cắt giấy một phần" },
    "codepage":          { "value": "CP1258", "comment": "Bảng mã tiếng Việt cho máy in nhiệt; fallback: bỏ dấu" }
  }
}
