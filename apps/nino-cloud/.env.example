# =====================================================================
#  NINOTEK CLOUD — Biến môi trường
#  Chép thành .env rồi điền giá trị thật. KHÔNG commit file .env.
# =====================================================================

NODE_ENV=development
PORT=3000

# --- Database ---
DATABASE_URL=postgresql://ninotek:ninotek_dev_only@localhost:5432/ninotek
DATABASE_SCHEMA=nino
DATABASE_POOL_MAX=20

# --- JWT ---
# Sinh bằng: openssl rand -base64 48
JWT_SECRET=thay-bang-chuoi-ngau-nhien-that-truoc-khi-len-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# --- Webhook ngân hàng ---
# Secret dùng chung với cổng thanh toán (SePay / Casso) để ký HMAC-SHA256.
# ⚠️ Không có secret này thì BẤT KỲ AI cũng giả được lệnh "đã thanh toán".
WEBHOOK_HMAC_SECRET=thay-bang-secret-that-tu-cong-thanh-toan
# Cửa sổ chấp nhận lệch thời gian của webhook (giây) — chống replay attack
WEBHOOK_MAX_SKEW_SECONDS=300

# --- VietQR ---
VIETQR_SESSION_TTL_MINUTES=15
